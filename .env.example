# ForgeMind environment configuration.
# Copy to `.env` and fill in keys. NEVER hardcode keys in source.

# 1 = deterministic mock mode: no API keys required, no real LLM/web calls.
FORGEMIND_MOCK=0

# --- LLM providers (used by LiteLLM; pick the ones you need) ---
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# --- Ollama (local models; base URL only, no key) ---
OLLAMA_BASE_URL=http://localhost:11434

# --- Tools ---
# Web search: set exactly one of these (Tavily preferred; DuckDuckGo needs no key).
TAVILY_API_KEY=
# GitHub search (optional, raises rate limits when set).
GITHUB_TOKEN=

# --- Storage ---
# SQLite database file for profiles/feedback/taste.
FORGEMIND_DB=data/forgemind.db
# ChromaDB persistence directory.
FORGEMIND_VECTOR_DIR=data/chroma
